###> Symfony ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_to_a_long_random_string
DEFAULT_URI=https://api.arca.digisafrica.tech
SYMFONY_TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< Symfony ###

###> MySQL (service Docker "database") ###
MYSQL_DATABASE=arca
MYSQL_USER=arca
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password
DATABASE_URL="mysql://arca:change_me_db_password@database:3306/arca?serverVersion=8.0&charset=utf8mb4"
###< MySQL ###

###> Messenger / Mailer ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://mailer:1025
###< Messenger / Mailer ###

###> CORS — adapter au front réel ###
CORS_ALLOW_ORIGIN='*'
###< CORS ###

###> JWT (passphrase = celle utilisée pour générer les clés) ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase
###< JWT ###

###> Entrypoint ###
RUN_MIGRATIONS=1
###< Entrypoint ###
